{
  "name": "djai-canvas-community",
  "version": "0.1.0",
  "description": "Open-source, local-first infinite canvas and storyboard planner for visual thinking and film pre-production.",
  "keywords": [
    "infinite-canvas",
    "whiteboard",
    "storyboard",
    "storyboard-planner",
    "film-pre-production",
    "shot-planning",
    "mood-board",
    "visual-planning",
    "local-first",
    "self-hosted",
    "react",
    "typescript",
    "blocksuite"
  ],
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:browser": "playwright test",
    "server:build": "tsc -p tsconfig.server.json",
    "typecheck:server": "tsc -p tsconfig.server.json --noEmit",
    "test:server": "vitest run --config vitest.server.config.ts",
    "test:access:server": "npm run server:build && node .gsd/access-build/tests/oidc-provider.js --serve-access",
    "test:access": "playwright test --project=access"
  },
  "dependencies": {
    "@blocksuite/affine": "0.22.4",
    "@blocksuite/affine-gfx-group": "0.22.4",
    "@blocksuite/affine-widget-edgeless-selected-rect": "0.22.4",
    "@blocksuite/affine-widget-edgeless-zoom-toolbar": "0.22.4",
    "@blocksuite/data-view": "0.22.4",
    "@blocksuite/store": "0.22.4",
    "@fastify/cookie": "11.1.2",
    "@fastify/session": "11.1.3",
    "@preact/signals-core": "^1.14.4",
    "better-sqlite3": "13.0.3",
    "fastify": "5.12.5",
    "openid-client": "6.8.8",
    "pdf-lib": "^1.17.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rxjs": "7.8.2",
    "y-protocols": "1.0.7",
    "yjs": "13.6.31"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vanilla-extract/vite-plugin": "5.2.6",
    "@vitejs/plugin-react": "5.2.0",
    "typescript": "^5.6.3",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  }
}
